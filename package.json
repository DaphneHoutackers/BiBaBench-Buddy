{
    "name": "bibabenchbuddy",
    "private": false,
    "type": "module",
    "author": "Daphne Houtackers",
    "categories": [
        "Education"
    ],
    "description": "Free molecular biology lab calculators and bench tools for PCR, restriction digests, ligation, Gibson assembly, dilutions, buffers, protein assays and DNA sequence analysis.",
    "repository": {
        "type": "git",
        "url": "https://github.com/DaphneHoutackers/BiBaBenchBuddy"
    },
    "main": "dist-electron/main.js",
    "version": "2.2.3",
    "scripts": {
        "test": "node --test src/lib/*.test.js",
        "dev": "vite",
        "clean": "rm -rf dist dist-electron release",
        "build": "vite build",
        "app:build": "vite build && electron-builder",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -p ./jsconfig.json",
        "preview": "vite preview",
        "app:mac": "rm -rf dist dist-electron release && vite build && electron-builder --mac dmg",
        "clean:node": "rm -rf node_modules",
        "clean:package": "rm -rf package-lock.json",
        "analyze": "ANALYZE=true npm run app:mac",
        "update-enzymes": "node scripts/update-enzymes.js"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-toast": "^1.2.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@supabase/supabase-js": "^2.108.2",
        "@tanstack/react-query": "^5.84.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron-updater": "^6.8.3",
        "html2canvas": "^1.4.1",
        "lucide-react": "^0.475.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-icons": "^5.6.0",
        "react-markdown": "^9.0.1",
        "react-router-dom": "^6.26.0",
        "recharts": "^2.15.4",
        "tailwind-merge": "^3.0.2",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^22.13.5",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "depcheck": "^1.4.7",
        "electron": "^41.0.2",
        "electron-builder": "^26.8.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "eslint-plugin-unused-imports": "^4.3.0",
        "globals": "^15.15.0",
        "lefthook": "^2.1.4",
        "postcss": "^8.5.3",
        "rollup-plugin-visualizer": "^7.0.1",
        "size-limit": "^12.0.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.2",
        "vite": "^6.1.0",
        "vite-plugin-electron": "^0.29.1",
        "vite-plugin-electron-renderer": "^0.14.6"
    },
    "homepage": "https://bi-ba-bench-buddy.vercel.app/",
    "build": {
        "appId": "com.bibabenchbuddy.app",
        "productName": "BiBaBenchBuddy",
        "protocols": [
            {
                "name": "BiBaBenchBuddy authentication",
                "schemes": [
                    "bibabenchbuddy"
                ]
            }
        ],
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.education",
            "icon": "build/icon.icns",
            "identity": null,
            "artifactName": "BiBaBenchBuddy-${version}-mac-${arch}.${ext}"
        },
        "dmg": {
            "title": "BiBaBenchBuddy",
            "icon": "build/icon.icns",
            "iconSize": 100,
            "window": {
                "width": 550,
                "height": 350
            },
            "contents": [
                {
                    "x": 100,
                    "y": 170,
                    "type": "file"
                },
                {
                    "x": 320,
                    "y": 170,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "asar": true,
        "compression": "maximum",
        "removePackageScripts": true,
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "BiBaBenchBuddy",
            "perMachine": false
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico",
            "artifactName": "BiBaBenchBuddy-${version}-Setup.${ext}"
        },
        "publish": [
            {
                "provider": "github"
            }
        ]
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
